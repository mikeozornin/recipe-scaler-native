    "NSSpeechRecognitionUsageDescription": {
      "comment": "Privacy - Speech Recognition Usage Description",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recipe Scaler uses on-device speech recognition for Hands-free up and down scroll commands while you cook."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Recipe Scaler распознаёт речь на устройстве для команд прокрутки вверх и вниз в режиме Hands-free."
          }
        }
      }
    }
