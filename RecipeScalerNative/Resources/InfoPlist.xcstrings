            "state": "new",
            "value": "Recipe Scaler"
          }
        }
      }
    },
    "CFBundleName": {
      "comment": "Bundle name",
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "RecipeScalerNative"
          }
        }
      }
    },
    "NSCameraUsageDescription": {
      "comment": "Privacy - Camera Usage Description",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recipe Scaler uses the camera to scan QR codes to log in with your seed phrase, and for hands-free recipe scrolling while the screen is kept awake."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Recipe Scaler использует камеру, чтобы сканировать QR-код для входа по seed-фразе и для hands-free прокрутки рецепта, пока экран не гаснет."
          }
        }
      }
    },
    "NSMicrophoneUsageDescription": {
      "comment": "Privacy - Microphone Usage Description",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recipe Scaler uses the microphone so you can dictate messages to the AI assistant and speak scroll commands while cooking with Hands-free on."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Recipe Scaler использует микрофон, чтобы диктовать сообщения ассистенту и голосовые команды прокрутки в режиме Hands-free."
          }
        }
      }
    },
    "NSRemindersFullAccessUsageDescription": {
      "comment": "Privacy - Reminders Full Access Usage Description",
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Recipe Scaler syncs your shopping list with Apple Reminders so you can check off items on Apple Watch, ask Siri, and access your list from any Apple device."
          }
        }
      }
    },
    "NSRemindersUsageDescription": {
      "comment": "Privacy - Reminders Usage Description",
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Recipe Scaler syncs your shopping list with Apple Reminders so you can check off items on Apple Watch, ask Siri, and access your list from any Apple device."
          }
        }
      }
    },
    "Recipe Scaler recipe": {},
