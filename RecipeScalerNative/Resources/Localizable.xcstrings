    "legacyAuth.banner.details" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Open Recipe Scaler on each device while you have internet during this period — sign-in will update automatically. If you miss a device, sign in once with your seed phrase and you are set."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Откройте Recipe Scaler на каждом устройстве, пока есть интернет, в течение этого срока — вход обновится сам, без лишних действий. Если на каком-то устройстве не успеете, один раз войдите по seed-фразе — дальше всё работает как обычно."
          }
        }
      }
    },
