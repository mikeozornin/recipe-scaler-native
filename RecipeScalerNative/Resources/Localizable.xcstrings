    "account.feature-adoption.guide.created_recipe.why" : {
      "extractionState" : "translated",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This checkmark lights up as soon as you have your first own recipe — any: imported, written from scratch, or sent by the bot. Recipe Scaler can build recipes from almost anything, so you can grow your library every day."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Этот пункт засчитывается, как только у вас появляется первый собственный рецепт — любой: импортированный, написанный с нуля, присланный ботом. Recipe Scaler умеет собирать рецепты из чего угодно, так что пополнять библиотеку можно каждый день."
          }
        }
      }
    },
