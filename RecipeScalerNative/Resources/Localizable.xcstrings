    "account.feature-adoption.guide.imported_recipe.why" : {
      "extractionState" : "translated",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Import a recipe from anything: a website link, a chunk of text, or a photo (for example, a page from a cookbook). Recipe Scaler pulls the title, ingredients, and steps automatically — no manual retyping."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Импортируйте рецепт из чего угодно: ссылки на сайт, куска текста или фотографии (например, страницы из кулинарной книги). Recipe Scaler сам разберёт название, ингредиенты и шаги — переписывать руками не нужно."
          }
        }
      }
    },
