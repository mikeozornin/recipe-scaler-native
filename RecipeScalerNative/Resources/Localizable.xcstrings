    "account.feature-adoption.guide.connected_mcp_assistant.how.2" : {
      "extractionState" : "translated",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Open your assistant's settings — usually under «Connectors», «Integrations», or «Tools» — and add a new connector with this URL."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Откройте настройки ассистента — обычно раздел «Connectors», «Integrations» или «Tools» — и добавьте новый коннектор с этим адресом."
          }
        }
      }
    },
    "account.feature-adoption.guide.connected_mcp_assistant.how.3" : {
      "extractionState" : "translated",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Done — try asking «What's in my breakfast collection?» or «Add ingredients for tomorrow's dinner to the shopping list.»"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Готово — попробуйте спросить «Что у меня в подборке завтраков?» или «Добавь продукты для завтрашнего ужина в список покупок»."
          }
        }
      }
    },
    "account.feature-adoption.guide.connected_mcp_assistant.why" : {
      "extractionState" : "translated",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Connect Recipe Scaler to your AI assistant (Claude, Cursor, ChatGPT, Grok) via Model Context Protocol. Once connected, the assistant can search your recipes, build collections, plan menus, and add ingredients to the shopping list — without you switching apps."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Подключите Recipe Scaler к вашему ИИ-ассистенту (Claude, Cursor, ChatGPT, Grok) через Model Context Protocol. После подключения ассистент сможет искать рецепты, собирать подборки, планировать меню и добавлять продукты в список покупок — без переключения между приложениями."
          }
        }
      }
    },
