    "account.feature-adoption.guide.connected_mcp_assistant.how.1" : {
      "extractionState" : "translated",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Copy the link below — it's your personal MCP endpoint."
          }
        },
        "ru" : {
          "stringUnit" : {
