    "account.delete.seed.body" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To confirm, enter your 12-word seed phrase, to prove ownership of the account.\n\nWe won't be able to restore your data. Maybe you need to export your recipes just in case."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Для подтверждения введите вашу секретную фразу из 12 слов, чтобы подтвердить владение аккаунтом.\n\nМы не сможем восстановить ваши данные. Возможно, стоит экспортировать рецепты на всякий случай."
          }
        }
      }
    },
