      "pattern": "swipeActions\\(edge: \\.leading",
      "paths": ["RecipeScalerNativeWatch/Views/TimerListView.swift"]
    },
    {
      "id": "swipe-trailing-destructive",
      "description": "Trailing swipe action destructive (system red)",
      "pattern": "role: \\.destructive",
      "paths": ["RecipeScalerNativeWatch/Views/TimerListView.swift"]
    },
    {
      "id": "square-state-frame",
