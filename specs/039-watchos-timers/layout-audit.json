      "pattern": "(size: 48, weight: \\.medium|stateIconSize, weight: \\.medium)",
      "paths": [
        "RecipeScalerNativeWatch/Views/EmptyStateView.swift",
        "RecipeScalerNativeWatch/Views/ErrorStateView.swift",
        "RecipeScalerNativeWatch/Views/NotAuthorizedStateView.swift"
      ]
    },
