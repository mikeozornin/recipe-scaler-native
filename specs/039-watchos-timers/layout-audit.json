        "RecipeScalerNativeWatch/Views/TimerListView.swift",
        "RecipeScalerNativeWatch/Views/TimerRow.swift",
        "RecipeScalerNativeWatch/Services/WatchTimer.swift",
        "RecipeScalerCore/TimerViews/TimerLinearRow.swift"
      ]
    },
    {
      "id": "time-text-timer-interval",
      "description": "Live countdown via Text(timerInterval:) for running timers",
      "pattern": "Text\\(timerInterval:",
