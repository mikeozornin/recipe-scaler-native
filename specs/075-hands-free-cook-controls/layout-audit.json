  "required_files": [
    "RecipeScalerNative/Views/AwakeScrollLayout.swift",
    "RecipeScalerNative/Views/ScreenAwakeToggle.swift",
    "RecipeScalerNative/Views/ScreenAwakeStatusBanner.swift",
    "RecipeScalerNative/Views/YDocRecipeDetailView.swift",
    "RecipeScalerNative/Views/AwakeScrollHelpSheet.swift"
  ],
  "must_contain": [
    {
      "id": "scroll-fraction-75",
      "description": "Viewport scroll fraction token is 0.75",
      "pattern": "scrollViewportFraction:\\s*CGFloat\\s*=\\s*0\\.75",
      "paths": [
        "RecipeScalerNative/Views/AwakeScrollLayout.swift"
      ]
    },
    {
      "id": "preview-diameter-48",
      "description": "Optional camera preview is 48pt",
      "pattern": "cameraPreviewDiameter:\\s*CGFloat\\s*=\\s*48",
      "paths": [
        "RecipeScalerNative/Views/AwakeScrollLayout.swift"
      ]
    },
    {
      "id": "banner-ellipsis-size-16",
      "description": "Banner ellipsis visual size is 16pt",
      "pattern": "bannerAccessorySize:\\s*CGFloat\\s*=\\s*16",
      "paths": [
        "RecipeScalerNative/Views/AwakeScrollLayout.swift"
      ]
    },
    {
      "id": "banner-channel-icon-size-16",
      "description": "Banner channel icons are 16pt",
      "pattern": "bannerChannelIconSize:\\s*CGFloat\\s*=\\s*16",
      "paths": [
        "RecipeScalerNative/Views/AwakeScrollLayout.swift"
      ]
    },
    {
      "id": "help-chip-height-34",
      "description": "Voice chips are 34pt tall",
      "pattern": "helpChipHeight:\\s*CGFloat\\s*=\\s*34",
      "paths": [
        "RecipeScalerNative/Views/AwakeScrollLayout.swift"
      ]
    },
    {
      "id": "help-gesture-icon-size-64",
      "description": "Hand/face try-icons are 64pt",
      "pattern": "helpGestureIconSize:\\s*CGFloat\\s*=\\s*64",
      "paths": [
        "RecipeScalerNative/Views/AwakeScrollLayout.swift"
      ]
    },
    {
      "id": "awake-toggle-play",
      "description": "Keep-awake control is play.circle.fill (no second HF toolbar button)",
      "pattern": "play\\.circle\\.fill",
      "paths": [
        "RecipeScalerNative/Views/ScreenAwakeToggle.swift"
      ]
    },
    {
      "id": "banner-ellipsis",
      "description": "Banner hosts trailing ellipsis that opens the sheet",
      "pattern": "ellipsis",
      "paths": [
        "RecipeScalerNative/Views/ScreenAwakeStatusBanner.swift"
      ]
    },
    {
      "id": "banner-waveform",
      "description": "Banner shows waveform for voice channel",
      "pattern": "waveform",
      "paths": [
        "RecipeScalerNative/Views/ScreenAwakeStatusBanner.swift"
      ]
    },
    {
      "id": "banner-face-smiling",
      "description": "Banner shows face.smiling for face channel",
      "pattern": "face\\.smiling",
      "paths": [
        "RecipeScalerNative/Views/ScreenAwakeStatusBanner.swift"
      ]
    }
  ],
  "must_not_contain": [
    {
      "id": "no-hf-trailing-80-cook-chrome",
      "description": "Rev1 cook HF trailing pad must not reappear as product chrome requirement in detail",
      "pattern": "handsFreeTrailingPad",
      "paths": [
        "RecipeScalerNative/Views/YDocRecipeDetailView.swift"
      ]
    },
    {
      "id": "no-system-font-banner",
      "description": "Banner and sheet must not use SF via .font(.system",
      "pattern": "\\.font\\(\\.system\\(",
      "paths": [
        "RecipeScalerNative/Views/ScreenAwakeStatusBanner.swift",
        "RecipeScalerNative/Views/AwakeScrollHelpSheet.swift"
      ]
    },
    {
      "id": "no-two-item-banner-menu",
      "description": "Rev 3 Menu Toggle+Help must not remain as the banner chrome",
      "pattern": "Toggle\\(isOn:\\s*\\$handsFreeEnabled\\)",
      "paths": [
        "RecipeScalerNative/Views/ScreenAwakeStatusBanner.swift"
      ]
    }
  ],
  "previews": [
    {
      "id": "help-sheet-preview",
      "description": "Canvas preview for help/settings sheet",
      "pattern": "#Preview",
      "paths": [
        "RecipeScalerNative/Views/AwakeScrollHelpSheet.swift"
      ]
    }
  ],
  "acceptance_claims": [
    {
      "id": "claim-75-percent-delta",
      "description": "Each action scrolls 75% of visible height until clamp",
      "manual": true
    },
    {
      "id": "claim-awake-on-channels-off-no-camera",
      "description": "Awake ON and all channels OFF does not start camera (no green dot)",
      "manual": true
    },
    {
      "id": "claim-preview-overlay-not-inset",
      "description": "Preview overlay does not change ScrollView height",
      "manual": true
    },
    {
      "id": "claim-no-extra-toolbar-button",
      "description": "Only existing play.circle.fill awake toggle in toolbar",
      "manual": true
    },
    {
      "id": "claim-banner-ellipsis",
      "description": "Ellipsis is a Button in the keep-awake banner trailing edge; banner height ≤ 48pt",
      "manual": true
    },
    {
      "id": "claim-sheet-from-ellipsis",
      "description": "Settings/help sheet opens from banner ellipsis, not from toolbar",
      "manual": true
    },
    {
      "id": "claim-banner-channel-icons",
      "description": "After keep-awake title, 16pt icons for enabled channels only, order voice→hand→face",
      "manual": true
    },
    {
      "id": "claim-live-one-accent",
      "description": "Live feedback recolors one chip or one 64pt icon, not the whole row",
      "manual": true
    },
    {
      "id": "claim-denied-settings",
      "description": "Denied: toggle OFF+disabled, orange caption, Open Settings if at least one permission denied",
      "manual": true
    },
    {
      "id": "claim-hide-face-without-truedepth",
      "description": "Face row is absent when TrueDepth is unsupported",
      "manual": true
    }
  ]
}
