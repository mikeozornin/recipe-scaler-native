      "paths": ["RecipeScalerNative/Views/Cooking/CookingPermissionsSheet.swift"]
    },
    {
      "id": "cooking-permissions-sheet-privacy-hint",
      "description": "Permissions sheet includes privacy hint text",
      "pattern": "cooking\\.permission\\.privacy-hint",
      "paths": ["RecipeScalerNative/Views/Cooking/CookingPermissionsSheet.swift"]
    },
    {
      "id": "cooking-recipe-detail-entry-button",
