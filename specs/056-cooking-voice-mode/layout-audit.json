      "paths": ["RecipeScalerNative/Views/YDocRecipeDetailView.swift"]
    },
    {
      "id": "cooking-classifier-nfkd-normalize",
      "description": "CookingCommandClassifier uses NFKD normalization for diacritics",
      "pattern": "(NFKD|nfkd|trimmingCharacters.*whitespace|folding\\(options: \\.diacriticInsensitive)",
      "paths": ["RecipeScalerNative/Services/Cooking/CookingCommandClassifier.swift"]
    },
    {
      "id": "cooking-classifier-lowercase",
      "description": "CookingCommandClassifier lowercases input (case-insensitive per search rule)",
      "pattern": "\\.lowercased\\(\\)",
      "paths": ["RecipeScalerNative/Services/Cooking/CookingCommandClassifier.swift"]
    },
    {
      "id": "cooking-classifier-synonym-dict-ru",
      "description": "Synonym dictionary contains Russian commands",
      "pattern": "(дальше|вперёд|следующий|назад|повтори|запусти|пауза|продолжи|стоп)",
      "paths": ["RecipeScalerNative/Services/Cooking/CookingSynonymDictionary.swift"]
    },
    {
      "id": "cooking-classifier-synonym-dict-en",
      "description": "Synonym dictionary contains English commands",
      "pattern": "(next|back|previous|repeat|pause|resume|stop|cancel)",
      "paths": ["RecipeScalerNative/Services/Cooking/CookingSynonymDictionary.swift"]
    },
    {
      "id": "cooking-voice-provider-strategy",
      "description": "CookingVoiceProvider switches engine by iOS version availability",
      "pattern": "#available\\(iOS 26",
      "paths": ["RecipeScalerNative/Services/Cooking/CookingVoiceProvider.swift"]
    },
    {
      "id": "cooking-voice-provider-main-actor",
      "description": "CookingVoiceProvider is @MainActor (per concurrency rules)",
      "pattern": "@MainActor",
      "paths": ["RecipeScalerNative/Services/Cooking/CookingVoiceProvider.swift"]
    },
    {
      "id": "cooking-audio-sf-on-device-required",
      "description": "CookingAudioEngineSF requires on-device recognition (privacy)",
      "pattern": "requiresOnDeviceRecognition\\s*=\\s*true",
      "paths": ["RecipeScalerNative/Services/Cooking/CookingAudioEngineSF.swift"]
    },
    {
      "id": "cooking-audio-sf-partial-results",
      "description": "CookingAudioEngineSF requests partial results for responsive UX",
      "pattern": "shouldReportPartialResults\\s*=\\s*true",
      "paths": ["RecipeScalerNative/Services/Cooking/CookingAudioEngineSF.swift"]
    },
    {
      "id": "cooking-audio-analyzer-available-guard",
      "description": "CookingAudioAnalyzer guarded with @available(iOS 26.0, *)",
      "pattern": "@available\\(iOS 26\\.0",
      "paths": ["RecipeScalerNative/Services/Cooking/CookingAudioAnalyzer.swift"]
    },
    {
      "id": "cooking-tts-mic-suspend",
      "description": "CookingSpeechSynthesizer suspends mic while speaking (feedback loop prevention)",
      "pattern": "(onMicSuspend|willSpeakRange)",
      "paths": ["RecipeScalerNative/Services/Cooking/CookingSpeechSynthesizer.swift"]
    },
    {
      "id": "cooking-tts-mic-resume",
      "description": "CookingSpeechSynthesizer resumes mic when finished",
      "pattern": "(onMicResume|didFinish)",
      "paths": ["RecipeScalerNative/Services/Cooking/CookingSpeechSynthesizer.swift"]
    },
    {
      "id": "cooking-timer-stepid-field",
      "description": "RecipeTimer struct has optional stepId field",
      "pattern": "(let|var)\\s+stepId:\\s*String\\?",
