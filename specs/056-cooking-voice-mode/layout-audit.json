    },
    {
      "id": "cooking-i18n-confirm-step",
      "description": "cooking.confirm.step-n localized key used (with placeholder)",
      "pattern": "cooking\\.confirm\\.step",
      "paths": ["RecipeScalerNative"]
    },
    {
      "id": "cooking-i18n-not-understood",
      "description": "cooking.confirm.not-understood localized key used",
      "pattern": "cooking\\.confirm\\.not-understood",
      "paths": ["RecipeScalerNative"]
    },
    {
      "id": "cooking-i18n-start-button",
      "description": "cooking.start-button localized key used in detail view",
      "pattern": "cooking\\.start-button",
      "paths": ["RecipeScalerNative/Views"]
    },
    {
      "id": "cooking-view-environment-injection",
      "description": "CookingModeView uses @Environment for voice provider (DI pattern)",
      "pattern": "@Environment\\(.*CookingVoiceProvider",
      "paths": ["RecipeScalerNative/Views/Cooking/CookingModeView.swift"]
    },
    {
      "id": "cooking-observable-session-vm",
      "description": "CookingSessionViewModel uses @Observable (modern Observation)",
      "pattern": "@Observable",
      "paths": ["RecipeScalerNative/ViewModels/CookingSessionViewModel.swift"]
    }
  ],
  "must_not_contain": [
    {
      "id": "no-timer-publish-cooking",
      "description": "Cooking views must not use Timer.publish (battery, system-driven countdown)",
      "pattern": "Timer\\.publish",
      "paths": ["RecipeScalerNative/Views/Cooking"]
    },
    {
      "id": "no-system-font-text-cooking",
      "description": "Text views in Cooking must not use .font(.system(size:)) — Martian required",
      "pattern": "Text\\([^)]*\\)[\\s\\S]{0,200}?\\.font\\(\\.system\\(size:",
      "paths": ["RecipeScalerNative/Views/Cooking"]
    },
    {
      "id": "no-hardcoded-ru-text-cooking",
      "description": "No hardcoded Russian UI strings in view files",
      "pattern": "(?=.{0,200}Text\\(\"[А-Яа-яЁё])",
      "paths": ["RecipeScalerNative/Views/Cooking"]
    },
    {
      "id": "no-hardcoded-en-text-cooking",
      "description": "No hardcoded English UI strings in view files (use LocalizedStringKey)",
      "pattern": "Text\\(\"(Cook|Listen|Speaking|Next|Previous|Pause|Resume|Stop|Cancel|Continue)\"\\)",
      "paths": ["RecipeScalerNative/Views/Cooking"]
    },
    {
      "id": "no-available-ios-27-in-cooking",
      "description": "Cooking feature must NOT require iOS 27 — works on iOS 17+ (only SpeechAnalyzer needs iOS 26)",
      "pattern": "#available\\(iOS 27",
      "paths": ["RecipeScalerNative/Views/Cooking", "RecipeScalerNative/Services/Cooking"]
    },
    {
      "id": "no-shared-service-direct-access-cooking",
      "description": "CookingModeView must not access services via .shared — use @Environment per CLAUDE.md",
      "pattern": "CookingVoiceProvider\\.shared|CookingSpeechSynthesizer\\.shared",
      "paths": ["RecipeScalerNative/Views/Cooking"]
    },
    {
      "id": "no-server-url-for-speech",
      "description": "Speech pipeline must not hit any server URL — on-device only",
      "pattern": "(https?://.*speech|ingest.*127\\.0\\.0\\.1.*speech)",
      "paths": ["RecipeScalerNative/Services/Cooking"]
    },
    {
      "id": "no-force-unwrap-cooking-views",
      "description": "No force-unwrap ! in cooking views (outside #Preview)",
      "pattern": "[a-zA-Z_][a-zA-Z0-9_]*!",
      "paths": ["RecipeScalerNative/Views/Cooking"]
    }
  ],
