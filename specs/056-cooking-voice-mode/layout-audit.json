  "acceptance_claims": [
    {
      "id": "peek-three-claim",
      "description": "На любом screen size виден хотя бы 24pt предыдущего и следующего шага, когда они есть",
      "manual": true
    },
    {
      "id": "pill-fixed-top-claim",
      "description": "Voice status pill остаётся в top safe area при скролле шагов",
      "manual": true
    },
    {
      "id": "controls-fixed-bottom-claim",
      "description": "Prev/Next кнопки всегда внизу экрана, не уезжают при скролле",
      "manual": true
    },
    {
      "id": "focused-vs-peek-visual-claim",
      "description": "Focused step card визуально отличается от peek (background + foreground)",
      "manual": true
    },
    {
      "id": "tap-target-44-claim",
      "description": "Все интерактивные элементы имеют tap area ≥ 44pt",
      "manual": true
    },
    {
      "id": "martian-everywhere-claim",
      "description": "Весь текст в Cooking UI использует Martian (кроме SF Symbol для Image)",
      "manual": true
    },
    {
      "id": "ios17-builds-claim",
      "description": "App собирается и запускается на iOS 17 симуляторе; Cooking mode открывается, навигация кнопками работает, voice (если доступен) реагирует на команды",
      "manual": true
    },
    {
      "id": "ios26-uses-speech-analyzer-claim",
      "description": "На iOS 26 симуляторе voice pipeline использует SpeechAnalyzer (по логу AppLog cooking.voice_provider engine=speechAnalyzer)",
      "manual": true
    },
    {
      "id": "feedback-loop-prevention-claim",
      "description": "TTS speaking приостанавливает микрофон — нет ситуации когда TTS распознаётся как команда",
      "manual": true
    },
    {
      "id": "interruption-recovery-claim",
      "description": "После входящего звонка / Siri во время готовки микрофон корректно освобождается и возобновляется после возвращения в app",
      "manual": true
    },
    {
      "id": "permission-denied-graceful-claim",
      "description": "При отказе в разрешении на микрофон/речь Cooking mode открывается в режиме «только кнопки» без краша, voice pill показывает .muted/.error",
      "manual": true
    },
    {
      "id": "stepid-backward-compat-claim",
      "description": "Старые серверные payload без stepId десериализуются без ошибок, таймеры работают",
      "manual": true
    },
    {
      "id": "battery-reasonable-claim",
      "description": "30 минут listening в Cooking mode разряжает батарею не более чем на 15% на iPhone 15+ (manual benchmark)",
      "manual": true
    }
  ]
