      "pattern": "scrollTargetBehavior\\(\\.viewAligned\\)",
      "paths": ["RecipeScalerNative/Views/Cooking/CookingModeView.swift"]
    },
    {
      "id": "cooking-scroll-target-layout",
      "description": "scrollTargetLayout() on LazyVStack for viewAligned to work",
      "pattern": "scrollTargetLayout\\(\\)",
      "paths": ["RecipeScalerNative/Views/Cooking/CookingModeView.swift"]
    },
    {
      "id": "cooking-scroll-view-reader",
      "description": "ScrollViewReader used to programmatically scroll to current step",
      "pattern": "ScrollViewReader",
      "paths": ["RecipeScalerNative/Views/Cooking/CookingModeView.swift"]
    },
    {
      "id": "cooking-screen-awake-on-appear",
      "description": "ScreenAwakeController.setActive(true) on .onAppear",
      "pattern": "ScreenAwakeController\\.setActive\\(true\\)",
