      "description": "Prev/Next buttons ≥ 49pt touch target (uses controlButtonSize token)",
      "pattern": "(controlButtonSize|frame\\(width: 5[6-9]|frame\\(width: [6-9][0-9])",
      "paths": ["RecipeScalerNative/Views/Cooking/CookingModeView.swift"]
    },
    {
      "id": "cooking-voice-pill-martian",
      "description": "Voice status pill uses Martian Grotesk font",
