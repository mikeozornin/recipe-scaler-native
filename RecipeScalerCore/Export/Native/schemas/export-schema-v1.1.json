{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Recipe Scaler Export Format v1.1",
  "description": "Schema for Recipe Scaler export format version 1.1 (with images in ZIP)",
  "type": "object",
  "required": ["metadata", "recipes", "imageFiles"],
  "properties": {
    "metadata": {
      "type": "object",
      "required": ["version", "exportDate", "type", "count"],
      "properties": {
        "version": {
          "type": "string",
          "enum": ["1.1"],
          "description": "Format version must be 1.1"
        },
        "exportDate": {
          "type": "string",
          "format": "date-time",
          "description": "ISO 8601 date-time when export was created"
        },
        "type": {
          "type": "string",
          "enum": ["recipes-v1.1"],
          "description": "Export type"
        },
        "count": {
          "type": "integer",
          "minimum": 0,
          "description": "Number of recipes in export"
        }
      },
      "additionalProperties": false
    },
    "recipes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name"],
        "properties": {
          "id": {
            "type": "string",
            "description": "Unique recipe identifier"
          },
          "name": {
            "type": "string",
            "description": "Recipe name"
          },
          "description": {
            "type": ["string", "null"],
            "description": "Recipe description/steps"
          },
          "ingredients": {
            "type": "array",
            "description": "Array of ingredients",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "name": {
                  "type": "string"
                },
                "originalAmount": {
                  "type": ["number", "null"]
                },
                "unit": {
                  "type": "string"
                },
                "order": {
                  "type": "number"
                },
                "isSeparator": {
                  "type": "boolean"
                }
              }
            }
          },
          "color": {
            "type": ["string", "null"],
            "description": "Recipe color"
          },
          "scaleFactor": {
            "type": ["number", "string"],
            "description": "Current scale factor"
          },
          "createdAt": {
            "type": ["string", "null"],
            "format": "date-time",
            "description": "ISO 8601 date-time when recipe was created"
          },
          "updatedAt": {
            "type": ["string", "null"],
            "format": "date-time",
            "description": "ISO 8601 date-time when recipe was last updated"
          },
          "originalRecipeLink": {
            "type": ["string", "null"],
            "description": "Link to original recipe"
          },
          "originalRecipe": {
            "type": ["string", "null"],
            "description": "Original recipe text"
          }
        },
        "additionalProperties": true
      }
    },
    "imageFiles": {
      "type": "object",
      "description": "Mapping of recipe IDs to image file paths in ZIP",
      "patternProperties": {
        "^[a-zA-Z0-9_-]+$": {
          "type": "object",
          "required": ["full", "preview"],
          "properties": {
            "full": {
              "type": "string",
              "pattern": "^images/[^/]+/full\\.webp$",
              "description": "Path to full image in ZIP (format: images/{recipeId}/full.webp)"
            },
            "preview": {
              "type": "string",
              "pattern": "^images/[^/]+/preview\\.webp$",
              "description": "Path to preview image in ZIP (format: images/{recipeId}/preview.webp)"
            }
          },
          "additionalProperties": false
        }
      }
    }
  },
  "additionalProperties": false
}

