{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Recipe Scaler Export Format v1.0",
  "description": "Schema for Recipe Scaler export format version 1.0 (without images)",
  "type": "object",
  "required": ["metadata", "recipes"],
  "properties": {
    "metadata": {
      "type": "object",
      "required": ["exportDate", "type", "count"],
      "properties": {
        "version": {
          "type": "string",
          "enum": ["1.0"],
          "description": "Format version. If missing, defaults to 1.0"
        },
        "exportDate": {
          "type": "string",
          "format": "date-time",
          "description": "ISO 8601 date-time when export was created"
        },
        "type": {
          "type": "string",
          "enum": ["recipes-v1.0", "recipes-simple"],
          "description": "Export type. 'recipes-simple' is legacy and treated as v1.0"
        },
        "count": {
          "type": "integer",
          "minimum": 0,
          "description": "Number of recipes in export"
        },
        "description": {
          "type": "string",
          "description": "Optional description of the export"
        }
      },
      "additionalProperties": false
    },
    "recipes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name"],
        "properties": {
          "id": {
            "type": "string",
            "description": "Unique recipe identifier"
          },
          "name": {
            "type": "string",
            "description": "Recipe name"
          },
          "description": {
            "type": ["string", "null"],
            "description": "Recipe description/steps"
          },
          "ingredients": {
            "type": "array",
            "description": "Array of ingredients",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "name": {
                  "type": "string"
                },
                "originalAmount": {
                  "type": ["number", "null"]
                },
                "unit": {
                  "type": "string"
                },
                "order": {
                  "type": "number"
                },
                "isSeparator": {
                  "type": "boolean"
                }
              }
            }
          },
          "color": {
            "type": ["string", "null"],
            "description": "Recipe color"
          },
          "scaleFactor": {
            "type": ["number", "string"],
            "description": "Current scale factor"
          },
          "createdAt": {
            "type": ["string", "null"],
            "format": "date-time",
            "description": "ISO 8601 date-time when recipe was created"
          },
          "updatedAt": {
            "type": ["string", "null"],
            "format": "date-time",
            "description": "ISO 8601 date-time when recipe was last updated"
          },
          "originalRecipeLink": {
            "type": ["string", "null"],
            "description": "Link to original recipe"
          },
          "originalRecipe": {
            "type": ["string", "null"],
            "description": "Original recipe text"
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": false
}

