# App Store Connect API — copy to asc.env.local and fill in.
# asc.env.local is gitignored; never commit the .p8 private key.
# Docs: store/README.md § Listing metadata & ASC API
# Where to get values:
#   https://appstoreconnect.apple.com/access/integrations/api
#   Keys → your key → Key ID (10 chars) + Issuer ID (UUID at top of page)
#   Download .p8 once when creating the key; store outside the repo.

ASC_KEY_ID=
ASC_ISSUER_ID=
ASC_P8_PATH=/Users/mike/work/git-repos/projects/recipe-scaler/recipe-scaler-apple-api-connect-app-manager.p8
